<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlaceTrack Placement Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
        bool isHome = path == "/" || path == "/index";
        bool isStudents = path.StartsWith("/students");
        bool isCompanies = path.StartsWith("/companies");
        bool isPlacements = path.StartsWith("/placements");
        bool isReports = path.StartsWith("/reports");
    }

    <div class="dashboard">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-sparkle">✦</span>
                <span class="brand-text">PlaceTrack</span>
            </div>
            
            <p class="nav-label">WORKSPACE</p>

            <nav class="sidebar-nav">
                <a class="@(isHome ? "active" : "")" href="/">
                    <span class="nav-icon">▦</span>
                    <span>Dashboard</span>
                </a>
                <a class="@(isStudents ? "active" : "")" href="/Students">
                    <span class="nav-icon">♙</span>
                    <span>Students</span>
                </a>
                <a class="@(isCompanies ? "active" : "")" href="/Companies">
                    <span class="nav-icon">▣</span>
                    <span>Companies</span>
                </a>
                <a class="@(isPlacements ? "active" : "")" href="/Placements">
                    <span class="nav-icon">◎</span>
                    <span>Placements</span>
                </a>
                <a class="@(isReports ? "active" : "")" href="/Reports">
                    <span class="nav-icon">▤</span>
                    <span>Reports</span>
                </a>
            </nav>

            <div class="db-badge">
                <span class="status-dot"></span>
                <span>MongoDB Active</span>
            </div>

            <div class="side-footer">PLACEMENT PORTAL · 2026</div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div class="breadcrumb">
                    <span>PlaceTrack</span>
                    <span class="bc-sep">/</span>
                    <span class="bc-current">@(ViewData["Title"] ?? "Dashboard")</span>
                </div>
                <div class="topbar-right">
                    <span class="academic-year">AY 2026–2027</span>
                    <div class="avatar" title="Placement Coordinator">AD</div>
                </div>
            </header>

            <div class="page-body">
                @RenderBody()
            </div>

            <footer class="page-footer">
                PlaceTrack · Campus Placement & Career Automation Portal
            </footer>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
