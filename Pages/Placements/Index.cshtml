@page
@model PlacementDashboard.Pages.Placements.IndexModel
@{
    ViewData["Title"] = "Placements";
}

<section class="welcome">
    <div class="welcome-header">
        <div>
            <p class="eyebrow">MATCHING & OFFERS</p>
            <h1>Campus Placements</h1>
            <p class="subtitle">Log successful recruitment offers, accepted packages, and interview outcomes.</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="toggleModal('placementModal')">+ Record Placement Offer</button>
        </div>
    </div>
</section>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">
        <span>✓ @Model.SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <span>⚠ @Model.ErrorMessage</span>
    </div>
}

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Recorded Placement Records (@Model.Placements.Count)</h2>
            <p>Direct linkage between student candidates and visiting corporate employers</p>
        </div>

        <div class="table-actions">
            <input type="search" id="placementSearch" class="search-input" placeholder="Search by student, company, package..." />
        </div>
    </div>

    <div class="table-wrapper">
        <table id="placementTable">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Hiring Company</th>
                    <th>Package (CTC)</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Placements)
                {
                    var studentName = Model.StudentsMap.TryGetValue(p.StudentId, out var s) ? s.Name : "Student (" + p.StudentId[..Math.Min(6, p.StudentId.Length)] + ")";
                    var studentEmail = s?.Email ?? "";
                    var companyName = Model.CompaniesMap.TryGetValue(p.CompanyId, out var c) ? c.Name : "Company (" + p.CompanyId[..Math.Min(6, p.CompanyId.Length)] + ")";
                    var companyRole = c?.JobRole ?? "Recruiter Offer";

                    <tr>
                        <td>
                            <div class="student-name-row">
                                <span class="student-avatar-mini">@(studentName.Length > 0 ? studentName[..1] : "?")</span>
                                <div>
                                    <strong class="student-name">@studentName</strong>
                                    @if (!string.IsNullOrEmpty(studentEmail))
                                    {
                                        <div class="student-email">@studentEmail</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <strong class="company-highlight">@companyName</strong>
                            <div class="text-muted" style="font-size:12px;">@companyRole</div>
                        </td>
                        <td><strong class="package-val">@p.PackageLPA.ToString("0.0") LPA</strong></td>
                        <td><span class="text-muted">@p.PlacementDate.ToString("dd MMM yyyy")</span></td>
                        <td>
                            <span class="status status-@(p.Status.ToLowerInvariant())">
                                @p.Status
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" onsubmit="return confirm('Remove placement record?');" style="display:inline;">
                                <button type="submit" class="btn btn-xs btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }

                @if (Model.Placements.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <div class="empty-icon">◎</div>
                            <h3>No placement offers recorded yet</h3>
                            <p>Click the button above to link a student offer with a company recruiter.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Record Placement Modal -->
<div id="placementModal" class="modal-backdrop" style="display:none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Record New Placement Offer</h3>
            <button type="button" class="close-btn" onclick="toggleModal('placementModal')">&times;</button>
        </div>
        <form method="post" asp-page-handler="Add">
            <div class="form-group">
                <label>Select Candidate Student *</label>
                <select asp-for="NewPlacement.StudentId" class="form-control" required>
                    <option value="">-- Choose Candidate --</option>
                    @foreach (var st in Model.AllStudents)
                    {
                        <option value="@st.Id">@st.Name (@st.Department - CGPA @st.CGPA.ToString("0.0"))</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Select Recruiting Company *</label>
                <select asp-for="NewPlacement.CompanyId" class="form-control" id="companySelect" onchange="autoFillPackage()" required>
                    <option value="">-- Choose Recruiter --</option>
                    @foreach (var cp in Model.AllCompanies)
                    {
                        <option value="@cp.Id" data-pkg="@cp.PackageLPA">@cp.Name - @cp.JobRole (@cp.PackageLPA LPA)</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Offered Package (LPA) *</label>
                    <input asp-for="NewPlacement.PackageLPA" id="packageInput" type="number" step="0.1" min="0" class="form-control" value="10.0" required />
                </div>

                <div class="form-group">
                    <label>Offer Status</label>
                    <select asp-for="NewPlacement.Status" class="form-control">
                        <option value="Placed">Placed (Offer Accepted)</option>
                        <option value="Applied">Applied / Pending Decision</option>
                        <option value="Interviewing">Interviewing</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="toggleModal('placementModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Placement</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleModal(id) {
            const m = document.getElementById(id);
            if (!m) return;
            m.style.display = m.style.display === "none" || !m.style.display ? "flex" : "none";
        }

        function autoFillPackage() {
            const sel = document.getElementById("companySelect");
            const opt = sel.options[sel.selectedIndex];
            const pkg = opt.getAttribute("data-pkg");
            if (pkg) {
                document.getElementById("packageInput").value = pkg;
            }
        }

        const search = document.getElementById("placementSearch");
        if (search) {
            search.addEventListener("input", function () {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll("#placementTable tbody tr").forEach(row => {
                    if (row.classList.contains("empty-state")) return;
                    row.hidden = !row.innerText.toLowerCase().includes(query);
                });
            });
        }
    </script>
}
