@page
@model PlacementDashboard.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<section class="welcome">
    <div class="welcome-header">
        <div>
            <p class="eyebrow">DIRECTORY</p>
            <h1>Student Management</h1>
            <p class="subtitle">View, search, register, and update student profiles in MongoDB.</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="toggleModal('studentModal')">+ Register New Student</button>
        </div>
    </div>
</section>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">
        <span>✓ @Model.SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <span>⚠ @Model.ErrorMessage</span>
    </div>
}

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Enrolled Candidates (@Model.Students.Count)</h2>
            <p>Filter by keywords or branch department</p>
        </div>

        <div class="table-actions">
            <input type="search" id="studentSearch" class="search-input" placeholder="Search name, email, department..." />
        </div>
    </div>

    <div class="table-wrapper">
        <table id="studentTable">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Email Address</th>
                    <th>Department</th>
                    <th>CGPA</th>
                    <th>Placement Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Students)
                {
                    <tr>
                        <td>
                            <div class="student-name-row">
                                <span class="student-avatar-mini">@(s.Name.Length > 0 ? s.Name[..1] : "?")</span>
                                <strong class="student-name">@s.Name</strong>
                            </div>
                        </td>
                        <td><span class="text-muted">@s.Email</span></td>
                        <td><span class="dept-pill">@s.Department</span></td>
                        <td><strong>@s.CGPA.ToString("0.00")</strong></td>
                        <td>
                            <span class="status status-@(s.PlacementStatus.ToLowerInvariant())">
                                @s.PlacementStatus
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" onsubmit="return confirm('Delete @s.Name?');" style="display:inline;">
                                <button type="submit" class="btn btn-xs btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }

                @if (Model.Students.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <div class="empty-icon">♙</div>
                            <h3>No students found</h3>
                            <p>Register students using the button above.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Register Student Modal -->
<div id="studentModal" class="modal-backdrop" style="display:none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Register New Student</h3>
            <button type="button" class="close-btn" onclick="toggleModal('studentModal')">&times;</button>
        </div>
        <form method="post" asp-page-handler="Add">
            <div class="form-group">
                <label>Full Name *</label>
                <input asp-for="NewStudent.Name" class="form-control" required placeholder="e.g. Rahul Sharma" />
            </div>

            <div class="form-group">
                <label>Email Address *</label>
                <input asp-for="NewStudent.Email" type="email" class="form-control" required placeholder="e.g. rahul@campus.edu" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Department / Branch</label>
                    <select asp-for="NewStudent.Department" class="form-control">
                        <option value="Computer Science">Computer Science</option>
                        <option value="Information Technology">Information Technology</option>
                        <option value="Data Science">Data Science</option>
                        <option value="Electronics">Electronics</option>
                        <option value="Mechanical">Mechanical</option>
                        <option value="Civil">Civil</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>CGPA (0.0 - 10.0)</label>
                    <input asp-for="NewStudent.CGPA" type="number" step="0.01" min="0" max="10" class="form-control" value="8.00" required />
                </div>
            </div>

            <div class="form-group">
                <label>Initial Status</label>
                <select asp-for="NewStudent.PlacementStatus" class="form-control">
                    <option value="Pending">Pending</option>
                    <option value="Interviewing">Interviewing</option>
                    <option value="Placed">Placed</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="toggleModal('studentModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save to MongoDB</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleModal(id) {
            const m = document.getElementById(id);
            if (!m) return;
            m.style.display = m.style.display === "none" || !m.style.display ? "flex" : "none";
        }

        const search = document.getElementById("studentSearch");
        if (search) {
            search.addEventListener("input", function () {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll("#studentTable tbody tr").forEach(row => {
                    if (row.classList.contains("empty-state")) return;
                    row.hidden = !row.innerText.toLowerCase().includes(query);
                });
            });
        }
    </script>
}
